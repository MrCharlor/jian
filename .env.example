# pnpm setup creates local credentials and adds a missing encryption keyring.
JIAN_API_TOKEN=replace-with-a-random-token-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://jian:replace-with-a-random-database-password@localhost:5432/jian
HOST=127.0.0.1
PORT=4310
JIAN_ROLE=all
# Optional IANA zone for agents and default schedule times, e.g. America/Sao_Paulo.
JIAN_TIME_ZONE=
# Optional provider credentials. The Providers screen detects them automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_API_TOKEN=
GEMINI_API_TOKEN=
# For a local compatible server without auth, a nonempty dummy key is acceptable.
# JIAN_PROVIDER_LOCAL=local
# JIAN_MCP_DOCS=

# pnpm setup generates a 32-byte key. Keep this keyring OUTSIDE database backups.
# Preserve old entries until every credential has been rotated.
JIAN_ACTIVE_KEY_ID=v1
JIAN_MASTER_KEYS='{"v1":"replace-with-base64-encoded-32-random-bytes"}'
# Exact origins, host-admin only. Metadata endpoints remain blocked.
JIAN_ALLOW_PRIVATE_ORIGINS=
# Optional Caveman proxy. Enable to start the bundled record-only listener in the image.
# For source development, start a separate record-only listener on the default port.
JIAN_CAVEMAN_ENABLED=false
JIAN_CAVEMAN_PROXY_URL=http://127.0.0.1:8788
